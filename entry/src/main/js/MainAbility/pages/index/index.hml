<!--
  ============================================================================
  index.hml — LAYAR UTAMA (redesign: SETIAP ELEMEN DALAM BOX/KARTU SENDIRI)
  ============================================================================
  Ukuran desain: 192 x 452 dp ≈ layar GT 7 Pro (454x454 px, area pakai ~80%).
  Semua tinggi/lebar blok ditulis EKSPISIT dalam px sehingga tidak pernah ada
  "baris kosong tak jelas" seperti laporan sebelumnya.

  Struktur (semua berkotak, jarak seragam):
    [BOX 1] Tanggal hari ini + jam sistem          (h 62)
    [BOX 2] Menuju sholat berikutnya + hitung mundur (h 104)
    [BOX 3..7] Lima kartu waktu sholat             (h 44 @84..)
    [BOX 8] Status pengingat/alarm Metode B        (h 44) ← tanpa pesan
            "tak tersedia"; alarm dicari lewat 4 jalur & dipasang otomatis.

  Aturan kompilator/runtime LiteWearable yang dipatuhi file ini:
    - class selector TIDAK boleh memakai data binding → kelas selalu statis;
    - atribut gaya per-item di-binding LANGSUNG ke tag tunggal
      (background-color / color / border-color), bukan `style="..."`;
    - setiap teks diberi width eksplisit + text-overflow ellipsis agar
      binding apa pun selalu punya tempat tampil (tidak hilang diam-diam).
  ============================================================================
-->
<div class="container">

  <!-- ==================== BOX 1: TANGGAL & JAM ==================== -->
  <div class="box box-tanggal">
    <text class="t-glav">{{ tanggalHariIni }}</text>
    <text class="t-jam">{{ jamSekarang }}</text>
  </div>

  <!-- ============ BOX 2: MENUJU SHOLAT BERIKUTNYA (glass besar) ============
       "pesanNext" satu string utuh ("Menuju Ashar") — hindari binding dua
       token berdempetan yang rawan gagal render di runtime lite. -->
  <div class="box box-next" if="{{ tersedia }}">
    <div class="dome"></div>
    <text class="t-next-label">{{ pesanNext }}</text>
    <text class="t-next-waktu">{{ waktuBerikutnya }}</text>
    <text class="t-next-sisa">{{ sisaWaktu }}</text>
  </div>

  <!-- ==================== BOX: JADWAL BELUM DIAISI ==================== -->
  <div class="box box-kosong" if="{{ tidakTersedia }}">
    <text class="t-kosong">Isi jadwal di common/jadwal-sholat.js</text>
  </div>

  <!-- ============ BOX 3-7: KARTU GLASS TIAP WAKTU SHOLAT ============
       Tiap baris = satu kartu mandiri (liquid glass): dome highlight di
       tepi atas + rim cahaya. Warna per-status via binding ATRIBUT. -->
  <div class="daftar" if="{{ tersedia }}">
    <div for="{{ jadwal }}" class="box baris" background-color="{{ $item.bg }}" border-color="{{ $item.rim }}">
      <div class="baris-dome" background-color="{{ $item.dome }}"></div>
      <text class="t-penanda" color="{{ $item.warnaPenanda }}">{{ $item.penanda }}</text>
      <text class="t-nama" color="{{ $item.warnaTeks }}">{{ $item.nama }}</text>
      <text class="t-waktu" color="{{ $item.warnaTeks }}">{{ $item.waktu }}</text>
    </div>
  </div>

  <!-- ============ BOX 8: STATUS PENGINGET (Metode A + Alarm B) ============
       Menggantikan pesan lama "modul alarm tak tersedia". `statusPengingat`
       kini SELALU terisi dari index.js (satu string utuh, aman untuk binding
       liteWearable); hmAlarm dicari otomatis lewat 4 jalur & dipasang ulang
       tiap aplikasi dibuka / ganti hari. -->
  <div class="box box-alarm">
    <text class="t-alarm" color="{{ warnaAlarm }}">{{ statusPengingat }}</text>
  </div>

</div>
