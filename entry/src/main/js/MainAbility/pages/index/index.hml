<!--
  ============================================================================
  index.hml — LAYAR UTAMA "KAPAN SOLAT" (versi bersih utk LegacyCompileLiteJS)
  ============================================================================
  Target layar GT 7 Pro 454x454 px. Aturan LiteWearable yang DIPATUHI KETAT:
    - TIDAK ada data binding pada atribut `class` (dilarang compiler) →
      kelas di sini HANYA string statis; warna per-status dibawa lewat
      ATRIBUT tag tunggal (background-color, color) dengan binding — pola
      resmi yang sudah terbukti lolos build + render di jam pengguna.
    - TIDAK memakai atribut kustom `lines` / `text-overflow` pada <text>
      (memicu warning "use customize attr") → semua teks pendek dan diberi
      width eksplisit sehingga tidak perlu pemotongan baris.
    - Setiap elemen punya lebar/tinggi tetap → layout stabil & ter-center.

  Desain saat ini:
    - BOX tanggal+jam → BOX "Menuju ..." (3 baris bertumpuk, font jam kecil)
      → GRID 2 kolom waktu sholat (nama + jam TERBACA penuh);
    - Tidak ada penanda centang/panah/dome/border mencolok;
    - Box status pengingat setelah Isya DIHAPUS.
  ============================================================================
-->
<div class="container">

  <!-- ==================== BOX 1: TANGGAL & JAM ==================== -->
  <div class="box box-tanggal">
    <text class="t-glav">{{ tanggalHariIni }}</text>
    <text class="t-jam">{{ jamSekarang }}</text>
  </div>

  <!-- ============ BOX 2: MENUJU SHOLAT BERIKUTNYA ============
       Tiga baris terpisah — nama, jam masuk, dan hitung mundur
       tidak mungkin saling menutupi. -->
  <div class="box box-next" if="{{ tersedia }}">
    <text class="t-next-label">{{ pesanNext }}</text>
    <text class="t-next-waktu">{{ waktuBerikutnya }}</text>
    <text class="t-next-sisa">{{ sisaWaktu }}</text>
  </div>

  <!-- ==================== BOX: jadwal belum diisi ==================== -->
  <div class="box box-kosong" if="{{ tidakTersedia }}">
    <text class="t-kosong">Isi jadwal di common/jadwal-sholat.js</text>
  </div>

  <!-- ============ GRID WAKTU SHOLAT (2 KOLOM x 3 BARIS) ============
       Lima kotak: Subuh|Zuhur / Ashar|Maghrib / Isya.
       Tiap kotak menampilkan NAMA + JAM masuknya dengan kontras penuh.

       Catatan teknis: warna per-status via binding atribut tag tunggal
       ($item.bg = background-color kartu, $item.warna = warna jam) —
       BUKAN binding pada class (ditolak LegacyCompileLiteJS), dan
       BUKAN atribut kustom lines/text-overflow (memicu warning). -->
  <div class="grid" if="{{ tersedia }}">
    <div for="{{ jadwal }}" tid="id" class="sel" background-color="{{ $item.bg }}">
      <text class="sel-nama">{{ $item.nama }}</text>
      <text class="sel-jam" color="{{ $item.warna }}">{{ $item.waktu }}</text>
    </div>
  </div>

</div>
