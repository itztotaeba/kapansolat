<!--
  ============================================================================
  index.hml — LAYAR UTAMA JADWAL SHOLAT (Huawei Watch GT 7 Pro / LiteWearable)
  ============================================================================
  Struktur (rapi, tanpa baris kosong):
    1. Tanggal hari ini (format Indonesia, dari jam sistem) + jam saat ini
    2. Kartu utama gaya "liquid glass" (kaca iOS 26): sholat berikutnya +
       hitung mundur. Efek kaca = lapisan highlight lengkung di tepi atas
       + rim cahaya — TANPA animasi, hemat baterai.
    3. Daftar 5 waktu sholat — SETIAP BARIS juga berbentuk kartu glass yang
       sama, dengan penanda status:
         ✓ = sudah lewat (redup) | ▶ = berlangsung | ➜ = berikutnya/mendatang
    Catatan: tidak ada kartu status alarm di layar (hemat ruang); status
    Metode B dicatat ke log dan tetap terpasang otomatis.
  CATATAN KOMPILER/RUNTIME LiteWearable yang dipatuhi file ini:
    - class selector TIDAK mendukung data binding → kelas selalu statis.
    - binding `style="..."` tidak didukung runtime → pakai atribut tag tunggal
      (`color`, `background-color`, `border-color`, `opacity`).
    - semua blok diberi ukuran px eksplisit di CSS (runtime tidak mengenal auto).
  ============================================================================
-->
<div class="container">

  <!-- ===== 1. HEADER: TANGGAL & JAM ===== -->
  <div class="header">
    <text class="tanggal">{{ tanggalHariIni }}</text>
    <text class="jam">{{ jamSekarang }}</text>
  </div>

  <!-- ===== 2. KARTU UTAMA "LIQUID GLASS": MENUJU SHOLAT BERIKUTNYA =====
       Teks "Menuju ..." dibuat SATU baris binding utuh ({{ pesanNext }}) —
       binding dua-token berdempetan ("Menuju {{ x }}") rawan gagal render
       pada runtime liteWearable dan meninggalkan ruang kosong tak jelas. -->
  <div class="kartu-next" if="{{ tersedia }}">
    <div class="glass-band"></div>
    <div class="glass-dome"></div>
    <text class="next-label">{{ pesanNext }}</text>
    <text class="next-waktu">{{ waktuBerikutnya }}</text>
    <text class="next-sisa">⏳ {{ sisaWaktu }}</text>
  </div>

  <!-- ===== PERINGATAN BILA DATA BELUM DIAISI ===== -->
  <div class="kosong" if="{{ tidakTersedia }}">
    <text class="kosong-teks">Jadwal belum tersedia. Isi blok data di common/jadwal-sholat.js</text>
  </div>

  <!-- ===== 3. DAFTAR 5 WAKTU SHOLAT (kartu glass per baris) =====
       Setiap baris = KARTU liquid-glass penuh: highlight lengkung ("dome")
       di tepi atas + rim cahaya tipis — gaya kaca iOS 26, tanpa animasi.
       Warna per-status lewat binding ATRIBUT tag tunggal (bukan `style=`
       dan bukan kelas dinamis — keduanya tidak didukung LiteWearable). -->
  <div class="daftar" if="{{ tersedia }}">
    <div for="{{ jadwal }}" class="baris" background-color="{{ $item.bg }}" border-color="{{ $item.rim }}">
      <div class="baris-dome" background-color="{{ $item.dome }}"></div>
      <text class="penanda" color="{{ $item.warnaPenanda }}">{{ $item.penanda }}</text>
      <text class="nama" color="{{ $item.warnaTeks }}">{{ $item.nama }}</text>
      <text class="waktu" color="{{ $item.warnaTeks }}">{{ $item.waktu }}</text>
    </div>
  </div>

</div>
