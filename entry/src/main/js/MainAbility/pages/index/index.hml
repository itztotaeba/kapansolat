<!--
  ============================================================================
  index.hml — LAYAR UTAMA "KAPAN SOLAT" (versi bersih, semua dalam box)
  ============================================================================
  Target layar GT 7 Pro 454x454 px. Aturan LiteWearable yang dipatuhi:
    - class selector TIDAK memakai data binding → kelas selalu statis;
    - warna per-status di-binding ke ATRIBUT tag tunggal (background-color,
      border-color, color), bukan `style` maupun `class`;
    - setiap teks diberi width eksplisit + lines:1 agar tidak hilang.

  Perubahan vs versi lama (permintaan pengguna):
    - TIDAK ada penanda ✓/▶/➜ dan dome/border mencolok lagi — tiap kotak
      cukup NAMA + JAM dengan kontras penuh agar jadwal terbaca jelas;
    - Waktu sholat memakai GRID 2 KOLOM;
    - Box status pengingat setelah Isya DIHAPUS.
  ============================================================================
-->
<div class="container">

  <!-- ==================== BOX 1: TANGGAL & JAM ==================== -->
  <div class="box box-tanggal">
    <text class="t-glav">{{ tanggalHariIni }}</text>
    <text class="t-jam">{{ jamSekarang }}</text>
  </div>

  <!-- ============ BOX 2: MENUJU SHOLAT BERIKUTNYA ============
       Nama sholat + jam masuk SEJAJAR satu baris (jam diperkecil agar
       tidak menutupi hitung mundur di bawahnya). -->
  <div class="box box-next" if="{{ tersedia }}">
    <div class="r-next">
      <text class="t-next-label">{{ pesanNext }}</text>
      <text class="t-next-waktu">{{ waktuBerikutnya }}</text>
    </div>
    <text class="t-next-sisa">{{ sisaWaktu }}</text>
  </div>

  <!-- ==================== BOX: jadwal belum diisi ==================== -->
  <div class="box box-kosong" if="{{ tidakTersedia }}">
    <text class="t-kosong">Isi jadwal di common/jadwal-sholat.js</text>
  </div>

  <!-- ============ GRID WAKTU SHOLAT (2 KOLOM x 3 BARIS) ============
       Enam kotak rata penuh. Tiap kotak: NAMA waktu + JAM masuknya.
       Kotak ke-6 = ringkasan sholat berikutnya (pengganti daftar vertikal). -->
  <div class="grid" if="{{ tersedia }}">
    <div for="{{ jadwal }}" class="sel" background-color="{{ $item.bg }}">
      <text class="sel-nama" color="{{ $item.warnaTeks }}">{{ $item.nama }}</text>
      <text class="sel-jam" color="{{ $item.warnaJam }}">{{ $item.waktu }}</text>
    </div>

    <div class="sel sel-info" background-color="{{ bgInfo }}">
      <text class="sel-nama" color="#9ed4ff">{{ infoJudul }}</text>
      <text class="sel-jam sel-jam-kecil" color="{{ warnaInfo }}">{{ infoTeks }}</text>
    </div>
  </div>

</div>
