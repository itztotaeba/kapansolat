<!--
  ============================================================================
  index.hml — LAYAR UTAMA "KAPAN SOLAT" (grid 2 kolom, tiap sel ber-kotak)
  ============================================================================
  Target layar GT 7 Pro 454x454 px. Aturan LiteWearable yang dipatuhi:
    - class selector TIDAK memakai data binding → kelas selalu statis;
    - warna per-status di-binding ke ATRIBUT tag tunggal (background-color,
      border-color, color), bukan lewat `style` maupun `class`;
    - setiap teks diberi width eksplisit + lines:1 agar tidak hilang.

  Struktur:
    [BOX] Tanggal hari ini + jam sistem
    [BOX] Menuju sholat berikutnya (label · waktu · hitung mundur)
    [GRID 2 KOLOM] 6 kotak: Subuh | Zuhur / Ashar | Maghrib / Isya | Pengingat
      → tiap kotak menampilkan NAMA waktu DAN JAM-nya (bukan daftar vertikal)
  ============================================================================
-->
<div class="container">

  <!-- ==================== BOX 1: TANGGAL & JAM ==================== -->
  <div class="box box-tanggal">
    <text class="t-glav">{{ tanggalHariIni }}</text>
    <text class="t-jam">{{ jamSekarang }}</text>
  </div>

  <!-- ============ BOX 2: MENUJU SHOLAT BERIKUTNYA ============ -->
  <div class="box box-next" if="{{ tersedia }}">
    <div class="dome"></div>
    <text class="t-next-label">{{ pesanNext }}</text>
    <text class="t-next-waktu">{{ waktuBerikutnya }}</text>
    <text class="t-next-sisa">{{ sisaWaktu }}</text>
  </div>

  <!-- ==================== BOX: jadwal belum diisi ==================== -->
  <div class="box box-kosong" if="{{ tidakTersedia }}">
    <text class="t-kosong">Isi jadwal di common/jadwal-sholat.js</text>
  </div>

  <!-- ============ GRID WAKTU SHOLAT (2 KOLOM, Tiap SEL = KARTU KACA) =====
       5 sel waktu sholat (for) + 1 sel pengingat = grid 3 baris x 2 kolom.
       Setiap sel: penanda status + NAMA waktu + JAM masuknya. -->
  <div class="grid" if="{{ tersedia }}">
    <div for="{{ jadwal }}" class="sel" background-color="{{ $item.bg }}" border-color="{{ $item.rim }}">
      <div class="sel-dome" background-color="{{ $item.dome }}"></div>
      <text class="sel-penanda" color="{{ $item.warnaPenanda }}">{{ $item.penanda }}</text>
      <text class="sel-nama" color="{{ $item.warnaTeks }}">{{ $item.nama }}</text>
      <text class="sel-jam" color="{{ $item.warnaJam }}">{{ $item.waktu }}</text>
    </div>

    <!-- SEL KE-6: status pengingat (Metode A+B) dalam kotak yang sama -->
    <div class="sel sel-alarm" background-color="{{ bgAlarm }}" border-color="{{ rimAlarm }}">
      <div class="sel-dome" background-color="{{ domeAlarm }}"></div>
      <text class="sel-penanda" color="#7fdca4">⏰</text>
      <text class="sel-nama" color="#cfe8d8">Pengingat</text>
      <text class="sel-jam sel-jam-kecil" color="{{ warnaAlarm }}">{{ ringkasAlarm }}</text>
    </div>
  </div>

</div>
