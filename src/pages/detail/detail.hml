<!--
  detail.hml - Jadwal 3 hari ke depan (termasuk hari ini).
  Berguna untuk mengecek kelengkapan data & melihat waktu esok.
-->
<div class="page">
  <text class="judul">Jadwal 3 Hari</text>

  <div class="hari" repeat="{{hari}}">
    <text class="tgl">{{$item.tanggal}}</text>
    <div class="baris">
      <text class="lbl">Subuh</text><text class="tm">{{$item.subuh}}</text>
      <text class="lbl">Zuhur</text><text class="tm">{{$item.zuhur}}</text>
    </div>
    <div class="baris">
      <text class="lbl">Ashar</text><text class="tm">{{$item.ashar}}</text>
      <text class="lbl">Maghrib</text><text class="tm">{{$item.maghrib}}</text>
    </div>
    <div class="baris">
      <text class="lbl">Isya</text><text class="tm">{{$item.isya}}</text>
      <text class="lbl"></text><text class="tm"></text>
    </div>
  </div>

  <input class="tombol" type="button" value="← Kembali" onclick="kembali" />
</div>
