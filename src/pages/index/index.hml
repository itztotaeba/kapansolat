<!--
  index.hml - LAYAR UTAMA Jadwal Sholat Hari Ini
  Huawei Watch GT 7 Pro (LiteWearable / HarmonyOS JS)

  Elemen ringan (text/div/image saja) -> hemat baterai & render cepat.
-->
<div class="page">

  <!-- ===== BANNER PENGINGAT METODE A (muncul H-10 menit, app terbuka) ===== -->
  <div class="banner" if="{{bannerTampil}}">
    <text class="banner-text">{{bannerPesan}}</text>
  </div>

  <!-- ===== TANGGAL HARI INI (dari sistem jam) ===== -->
  <text class="tanggal">{{tanggalHariIni}}</text>

  <!-- ===== SHOLAT BERIKUTNYA + COUNTDOWN ===== -->
  <div class="card-next" if="{{adaBerikutnya}}">
    <text class="next-label">{{labelBerikutnya}}</text>
    <text class="next-time">{{waktuBerikutnya}}</text>
    <text class="next-countdown">⏳ {{sisaWaktu}} lagi</text>
  </div>

  <!-- ===== PERINGATAN DATA BELUM DIISI ===== -->
  <div class="kosong" if="{{jadwalKosong}}">
    <text class="kosong-text">⚠️ Jadwal hari ini belum tersedia.

Isi blok JADWAL_SHOLAT pada file:
src/common/jadwal-sholat.js</text>
  </div>

  <!-- ===== DAFTAR 5 WAKTU SHOLAT HARI INI ===== -->
  <div class="row" repeat="{{items}}">
    <text class="row-status">{{$item.tanda}}</text>
    <text class="row-name {{$item.kelas}}">{{$item.label}}</text>
    <text class="row-time {{$item.kelas}}">{{$item.waktu}}</text>
  </div>

  <!-- ===== TOMBOL DETAIL (3 HARI KE DEPAN) ===== -->
  <input class="tombol" type="button" value="📅 Lihat 3 hari ke depan" onclick="bukaDetail" />

</div>
